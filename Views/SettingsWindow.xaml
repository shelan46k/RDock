<Window x:Class="RDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDock 設定"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFF5F5F7"
        FontFamily="Segoe UI, Microsoft JhengHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">

    <Border Padding="22,18">
        <StackPanel>
            <TextBlock Text="外觀與行為"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="圖示大小" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox x:Name="ComboIconSize" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                          SelectionChanged="ComboIconSize_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="魚眼倍率" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox x:Name="ComboMaxScale" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                          SelectionChanged="ComboMaxScale_SelectionChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="隱藏延遲" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox x:Name="ComboHideDelay" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                          SelectionChanged="ComboHideDelay_SelectionChanged"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="不透明度" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="3" Grid.Column="1">
                    <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="42"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                    <Slider x:Name="SliderOpacity"
                            Minimum="35" Maximum="95" TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="SliderOpacity_ValueChanged"/>
                </DockPanel>
            </Grid>

            <CheckBox x:Name="CheckRecycleBin" Content="顯示資源回收筒" Margin="0,4,0,6"
                      Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
            <CheckBox x:Name="CheckThisPC" Content="顯示本機" Margin="0,0,0,6"
                      Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
            <CheckBox x:Name="CheckClock" Content="顯示時鐘" Margin="0,0,0,6"
                      Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
            <CheckBox x:Name="CheckAppBar"
                      Content="保留工作區（最大化視窗不蓋住 Dock）"
                      Margin="0,0,0,2"
                      Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
            <TextBlock Text="說明：向系統登記邊緣保留區。若與工作列同邊，可能影響工作列顯示；Dock 自動隱藏時該邊緣會留白。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#FF666666"
                       Margin="18,0,0,8"/>
            <CheckBox x:Name="CheckFisheyePush" Content="魚眼推擠" Margin="0,0,0,14"
                      Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>

            <TextBlock Text="釘選執行中的程式"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,4,0,4"/>
            <TextBlock Text="僅列出有視窗的應用（顯示檔案描述名稱）。雙擊或按下方按鈕釘選。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#FF666666"
                       Margin="0,0,0,8"/>
            <ListBox x:Name="ListRunningApps"
                     Height="160"
                     BorderBrush="#33000000"
                     BorderThickness="1"
                     MouseDoubleClick="ListRunningApps_MouseDoubleClick"/>
            <Button Content="釘選選取的程式"
                    Margin="0,8,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Click="PinSelected_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="關閉" Width="88" Padding="0,6" IsCancel="True" IsDefault="True"
                        Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
