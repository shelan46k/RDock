<Window x:Class="RDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDock 設定"
        Width="1000"
        MinWidth="920"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel>
                <TextBlock Text="RDock 設定" Style="{StaticResource Text.Title}" Margin="0"/>
                <TextBlock Text="左側：外觀、Docklet、手動路徑　｜　右側：釘選執行中的程式"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Button Content="關閉"
                    Style="{StaticResource Btn.Primary}"
                    Width="112"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    IsDefault="True"
                    Click="Close_Click"/>
        </Border>

        <!-- 依內容撐高，三塊左欄與右欄清單都完整顯示 -->
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：決定整窗高度 -->
            <StackPanel x:Name="LeftColumn" Grid.Column="0">
                <Border Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外觀與行為" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="圖示大小" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox x:Name="ComboIconSize" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                      SelectionChanged="ComboIconSize_SelectionChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="魚眼倍率" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox x:Name="ComboMaxScale" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                      SelectionChanged="ComboMaxScale_SelectionChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="隱藏延遲" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox x:Name="ComboHideDelay" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                      SelectionChanged="ComboHideDelay_SelectionChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="不透明度" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DockPanel Grid.Row="3" Grid.Column="1">
                                <TextBlock x:Name="OpacityValueText"
                                           DockPanel.Dock="Right"
                                           MinWidth="44"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                                <Slider x:Name="SliderOpacity"
                                        Minimum="35" Maximum="95" TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        ValueChanged="SliderOpacity_ValueChanged"/>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Docklet" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CheckRecycleBin" Content="顯示資源回收筒" Margin="0,0,0,6"
                                  Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
                        <CheckBox x:Name="CheckThisPC" Content="顯示本機" Margin="0,0,0,6"
                                  Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
                        <CheckBox x:Name="CheckClock" Content="顯示時鐘" Margin="0,0,0,6"
                                  Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
                        <CheckBox x:Name="CheckAppBar"
                                  Content="保留工作區（最大化不蓋住 Dock）"
                                  Margin="0,0,0,4"
                                  Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
                        <TextBlock Text="與工作列同邊可能互相影響；自動隱藏時該邊會留白。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="26,0,0,6"/>
                        <CheckBox x:Name="CheckFisheyePush" Content="魚眼推擠" Margin="0"
                                  Checked="CheckFlags_Changed" Unchecked="CheckFlags_Changed"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="手動加入路徑" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" Margin="0,0,0,4"/>
                        <TextBlock Text="貼上 exe／捷徑／資料夾路徑，或按瀏覽選擇。"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="瀏覽…"
                                    Style="{StaticResource Btn.Secondary}"
                                    Margin="10,0,0,0"
                                    MinWidth="84"
                                    Click="BrowsePath_Click"/>
                            <TextBox x:Name="TextPinPath"
                                     KeyDown="TextPinPath_KeyDown"/>
                        </DockPanel>
                        <Button Content="加入到 Dock"
                                Style="{StaticResource Btn.Primary}"
                                HorizontalAlignment="Left"
                                MinWidth="128"
                                Click="PinPath_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右：高度對齊左欄，清單內部滾輪捲動 -->
            <Border Grid.Column="2"
                    Height="{Binding ActualHeight, ElementName=LeftColumn}"
                    VerticalAlignment="Top"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="釘選執行中的程式" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" Margin="0,0,0,4"/>
                        <TextBlock Text="僅列出有視窗的應用。可用滾輪瀏覽；雙擊或選取後釘選。"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom"
                            Content="釘選選取的程式"
                            Style="{StaticResource Btn.Secondary}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            MinWidth="140"
                            MinHeight="40"
                            Click="PinSelected_Click"/>
                    <ListBox x:Name="ListRunningApps"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             MouseDoubleClick="ListRunningApps_MouseDoubleClick"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
