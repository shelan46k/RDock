<Window x:Class="RDock.FolderStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Stack"
        Width="640"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        FontFamily="{StaticResource AppFont}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="RootBorder"
            Margin="12"
            Padding="18"
            CornerRadius="20"
            BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#F2161A22"/>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#55FFFFFF"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.5"
                              Color="#000000"
                              RenderingBias="Performance"/>
        </Border.Effect>

        <DockPanel>
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,14"
                    Padding="2,2,2,8"
                    Background="Transparent"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Content="關閉"
                            MinWidth="72" Height="36"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            FontSize="13"
                            FontFamily="{StaticResource AppFont}"
                            Foreground="#F5FFFFFF"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ViewModeButton"
                            DockPanel.Dock="Right"
                            Content="清單"
                            MinWidth="80" Height="36"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            FontSize="13"
                            FontFamily="{StaticResource AppFont}"
                            Foreground="#F5FFFFFF"
                            Cursor="Hand"
                            ToolTip="切換網格／清單"
                            Click="ViewModeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#F5FFFFFF"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0,12,0"
                               IsHitTestVisible="False"/>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ItemsScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,2,0">
                <Grid x:Name="ItemsHost"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
