<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Per-Monitor V2：跨螢幕拖曳 / 解析度變更時各自獨立 DPI -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\RDock.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Product>RDock</Product>
    <AssemblyTitle>RDock</AssemblyTitle>
    <Description>macOS style dock for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\RDock-Icon.png" />
    <None Include="Assets\RDock.ico" />
  </ItemGroup>

</Project>
